{
  "rules": {
    ".read": false,
    ".write": false,
    "relatos": {
      ".read": "auth != null && (root.child('usuarios').child(auth.uid).child('papel').val() === 'gestao' || (query.orderByChild === 'alunoUid' && query.equalTo === auth.uid))",
      ".indexOn": ["alunoUid"],
      "$relatoId": {
        ".write": "auth != null && (root.child('usuarios').child(auth.uid).child('papel').val() === 'gestao' || (!data.exists() && newData.child('alunoUid').val() === auth.uid))"
      }
    },
    "usuarios": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('papel').val() === 'gestao'",
      ".write": "auth != null && root.child('usuarios').child(auth.uid).child('papel').val() === 'gestao'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && (!data.exists() || data.child('papel').val() !== 'gestao') && newData.child('papel').val() === 'aluno'"
      }
    }
  }
}